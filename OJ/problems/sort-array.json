{
  "id": "sort-array",
  "title": "数组排序",
  "description": "给定一个整数数组，将其升序排序后输出。\n\n时间限制：1 秒；内存限制：128 MB。",
  "input_description": "第一行一个整数 n；第二行 n 个整数，为数组元素。",
  "output_description": "一行 n 个整数，为升序排序后的序列，用空格分隔。",
  "samples": [
    {
      "input": "5\n3 1 4 1 5",
      "output": "1 1 3 4 5"
    }
  ],
  "constraints": "1 ≤ n ≤ 10^5；-10^9 ≤ 数组元素 ≤ 10^9。",
  "testcases": [
    {
      "input": "5\n3 1 4 1 5",
      "output": "1 1 3 4 5"
    },
    {
      "input": "4\n-2 -1 -3 -4",
      "output": "-4 -3 -2 -1"
    },
    {
      "input": "1\n7",
      "output": "7"
    },
    {
      "input": "6\n8 8 8 8 8 8",
      "output": "8 8 8 8 8 8"
    }
  ],
  "time_limit": 1.0,
  "memory_limit": 128,
  "hint": "可直接调用语言内置排序；注意元素可能重复。",
  "source": "洛谷 P1177",
  "tags": [
    "排序",
    "数组"
  ],
  "author": "",
  "difficulty": "普及-"
}