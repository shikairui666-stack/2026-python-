{
  "id": "binary-search",
  "title": "二分查找",
  "description": "给定一个升序排列的数组和一个目标值 x，查找 x 在数组中的下标（从 0 开始）。若存在多个相同元素，输出最靠前（最小）的那个下标；若不存在，输出 -1。\n\n时间限制：1 秒；内存限制：64 MB。",
  "input_description": "第一行两个整数 n 和 x，表示数组长度和目标值；第二行 n 个升序整数。",
  "output_description": "一个整数，即 x 的最小下标；不存在则输出 -1。",
  "samples": [
    {
      "input": "5 3\n1 2 3 4 5",
      "output": "2"
    }
  ],
  "constraints": "1 ≤ n ≤ 10^5；-10^9 ≤ 数组元素, x ≤ 10^9，数组升序排列。",
  "testcases": [
    {
      "input": "5 3\n1 2 3 4 5",
      "output": "2"
    },
    {
      "input": "5 6\n1 2 3 4 5",
      "output": "-1"
    },
    {
      "input": "1 1\n1",
      "output": "0"
    },
    {
      "input": "7 4\n1 2 4 4 4 5 6",
      "output": "2"
    }
  ],
  "time_limit": 1.0,
  "memory_limit": 64,
  "hint": "标准二分查找，注意边界条件的处理。",
  "source": "LeetCode 704 变体",
  "tags": [
    "二分查找",
    "数组"
  ],
  "author": "",
  "difficulty": "普及-"
}