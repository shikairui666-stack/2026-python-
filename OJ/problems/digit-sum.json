{
  "id": "digit-sum",
  "title": "各位数字之和",
  "description": "给定一个非负整数 n，求它各位数字之和。\n\n时间限制：1 秒；内存限制：64 MB。",
  "input_description": "一行一个整数 n（可能非常大，建议按字符串处理）。",
  "output_description": "一个整数，即 n 各位数字之和。",
  "samples": [
    {
      "input": "123",
      "output": "6"
    }
  ],
  "constraints": "1 ≤ n 的位数 ≤ 1000，n 不含前导零（n = 0 除外）。",
  "testcases": [
    {
      "input": "123",
      "output": "6"
    },
    {
      "input": "999",
      "output": "27"
    },
    {
      "input": "1000000000000000000000000000000",
      "output": "1"
    },
    {
      "input": "123456789123456789",
      "output": "90"
    },
    {
      "input": "0",
      "output": "0"
    }
  ],
  "time_limit": 1.0,
  "memory_limit": 64,
  "hint": "n 可达 1000 位，无法用普通整型存储，应按字符串逐位处理。",
  "source": "洛谷 P1597 变体",
  "tags": [
    "字符串",
    "模拟"
  ],
  "author": "",
  "difficulty": "入门"
}